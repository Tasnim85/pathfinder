      "parameters": {
        "jsCode": "const BASE_URL = 'https://electric-nearest-mechanics-norm.trycloudflare.com'; // on la remplira à l'étape API\n\nconst item = $input.first();\nconst bin = item.binary || {};\nconst key = Object.keys(bin)[0] || null;\nconst fileName = key ? (bin[key].fileName || '').toLowerCase() : '';\nconst mime = key ? (bin[key].mimeType || '') : '';\n\nlet input_type = 'invalide';\nif (mime === 'application/pdf' || fileName.endsWith('.pdf')) input_type = 'cv';\nelse if (mime.startsWith('audio/') || /\\.(mp3|wav|m4a|ogg|flac|webm)$/.test(fileName)) input_type = 'audio';\n\nreturn [{ json: { base_url: BASE_URL, input_type, binary_key: key, file_name: fileName }, binary: bin }];"
      },
